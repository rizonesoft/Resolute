{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/clang++.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_RC_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/llvm-windres.exe",
                "CMAKE_MAKE_PROGRAM": "${sourceDir}/reskit/ninja/ninja.exe"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/clang++.exe",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_RC_COMPILER": "${sourceDir}/reskit/llvm-mingw/bin/llvm-windres.exe",
                "CMAKE_MAKE_PROGRAM": "${sourceDir}/reskit/ninja/ninja.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
