# Reference data, embedded per tool (D00 T06 §2; docs/reference-data.md).
#
#   resolute_embed_refdata(<target> [SOURCE_DIR <dir>] <dataset>...)
#
# The one place a target names the datasets it carries. Each named dataset's
# committed export (data/refdata/export/<dataset>.refdata, or SOURCE_DIR for a
# test's fixtures) is compressed at build time by scripts/refdata-embed.py and
# embedded in that target, and in no other, as an RCDATA resource named
# REFDATA_<NAME>. A target that does not call this carries no dataset.
#
# The export file is a declared input of the packed resource, and the packed
# resource of the compiled resource script, so changing an export rebuilds
# exactly what depends on it: nothing has to be cleaned.
#
# A dataset with no export file stops the configure step by name. The export
# itself is checked whole by the packer, so an edited or damaged file stops
# the build naming the dataset. No database is needed to build: the committed
# export files are the build's input.

find_program(RESOLUTE_PYTHON
    NAMES python python3
    HINTS "${CMAKE_SOURCE_DIR}/reskit/python"
    DOC "The Python that runs the build's reference-data packer")

function(resolute_embed_refdata target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "SOURCE_DIR" "")
    set(datasets ${ARG_UNPARSED_ARGUMENTS})
    if(NOT datasets)
        message(FATAL_ERROR "resolute_embed_refdata(${target}): name at least one dataset")
    endif()
    if(NOT RESOLUTE_PYTHON)
        message(FATAL_ERROR "resolute_embed_refdata(${target}): no Python was found to pack the datasets; run scripts/bootstrap.ps1")
    endif()
    if(ARG_SOURCE_DIR)
        set(source_dir "${ARG_SOURCE_DIR}")
    else()
        set(source_dir "${CMAKE_SOURCE_DIR}/data/refdata/export")
    endif()
    set(packer "${CMAKE_SOURCE_DIR}/scripts/refdata-embed.py")
    set(format "${CMAKE_SOURCE_DIR}/tools/refdata/refdata_format.py")
    set(out_dir "${CMAKE_BINARY_DIR}/refdata/${target}")
    set(script "// Generated by cmake/ResoluteRefdata.cmake for ${target}. Do not edit.\n")
    set(blobs "")
    foreach(dataset IN LISTS datasets)
        if(NOT dataset MATCHES "^[a-z0-9][a-z0-9_-]*$")
            message(FATAL_ERROR "resolute_embed_refdata(${target}): '${dataset}' is not a dataset name (lower-case letters, digits, hyphens and underscores)")
        endif()
        set(export "${source_dir}/${dataset}.refdata")
        if(NOT EXISTS "${export}")
            message(FATAL_ERROR "resolute_embed_refdata(${target}): the dataset '${dataset}' has no export at ${export}. "
                                "Export it on an authoring machine (python tools/refdata/refdata.py export) and commit the file.")
        endif()
        # The resource name scripts/refdata-embed.py resource-name gives: an
        # underscore doubled and a hyphen written _H, so no two datasets share one.
        string(REPLACE "_" "__" resource "${dataset}")
        string(REPLACE "-" "_h" resource "${resource}")
        string(TOUPPER "REFDATA_${resource}" resource)
        set(blob "${out_dir}/${dataset}.rdz")
        add_custom_command(
            OUTPUT "${blob}"
            COMMAND "${RESOLUTE_PYTHON}" "${packer}" pack "${export}" "${blob}"
            DEPENDS "${export}" "${packer}" "${format}"
            COMMENT "Packing reference data '${dataset}' for ${target}"
            VERBATIM)
        list(APPEND blobs "${blob}")
        string(APPEND script "${resource} RCDATA \"${blob}\"\n")
    endforeach()
    set(resource_script "${out_dir}/refdata.rc")
    # Written only when its text changes, so a configure that changes nothing
    # recompiles nothing.
    file(CONFIGURE OUTPUT "${resource_script}" CONTENT "${script}" @ONLY)
    target_sources(${target} PRIVATE "${resource_script}")
    set_property(SOURCE "${resource_script}" APPEND PROPERTY OBJECT_DEPENDS "${blobs}")
    set_property(TARGET ${target} PROPERTY RESOLUTE_REFDATA "${datasets}")
endfunction()
