{
  "extraKnownMarketplaces": {
    "resolute-tools": { "source": { "source": "directory", "path": "./tools/claude-plugins" } }
  },
  "enabledPlugins": {
    "resolute-lsp@resolute-tools": true
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 40 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 10 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "CronCreate", "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os, runpy, sys; sys.argv = ['dispatch_hook.py']; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(), 'scripts', 'dispatch_hook.py'), run_name='__main__')\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/run-guard.py\" hook", "timeout": 90 } ] }
    ]
  }
}
