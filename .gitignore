# Build artifacts and distribution folders
# Paths are unanchored so they keep matching wherever the AutoIt tree sits.
**/SDK/Concrete/*/Distribution/

# Compiled executables
*.exe

# Log files
*.log
**/Resolute/Logging/

# Temporary and cache files
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# IDE and editor files
.vs/
.vscode/
*.suo
*.user
*.sln.docstates

# AutoIt compiled files
*.a3x

# Zip packages
**/SDK/Concrete/*/*.zip
**/SDK/Concrete/*/Distribution/*/*.zip

# Windows thumbnail cache
ehthumbs.db
Desktop.ini

# Removed from repo
rescue-db/
.windsurf/
TODO.md
implementation_plan.md

# TODO graph derived cache (always reproducible from todo/*.md)
build/
__pycache__/

# Local working copies of the intake sources. Not part of this repository.
# ExoSuite, RegStudio, and SDImage are separate repositories under
# github.com/rizonesoft and are brought in by subtree merge, not by being
# committed here. Undelete is third-party reference material and is
# deliberately kept out of the tree; see D05 T05.
# Anchored with a leading slash so resolute_au3/samples/ is unaffected.
/samples/
