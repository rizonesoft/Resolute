1080:                self->EnsureVisible(self->m_selected);
1081:                SendMessageW(self->m_parent, WM_COMMAND,
1082:                    MAKEWPARAM(self->m_id, IDC_LISTVIEW_SELECT),
1083:                    reinterpret_cast<LPARAM>(hwnd));
1084:            }
1085:            return 0;
1086:        case VK_DOWN:
1087:            if (self->m_selected < self->m_itemCount - 1) {
1088:                self->Select(self->m_selected + 1);
1089:                self->EnsureVisible(self->m_selected);
1090:                SendMessageW(self->m_parent, WM_COMMAND,
1091:                    MAKEWPARAM(self->m_id, IDC_LISTVIEW_SELECT),
1092:                    reinterpret_cast<LPARAM>(hwnd));
1093:            }
1094:            return 0;
1095:        case VK_F2:
1096:            if (self->m_selected >= 0) self->BeginEdit(self->m_selected, 0);
1097:            return 0;
1098:        case VK_ESCAPE:
1099:            if (self->m_editActive) { self->EndEdit(false); return 0; }
1100:            break;
1101:        case VK_RETURN:
1102:            if (self->m_editActive) { self->EndEdit(true); return 0; }
1103:            break;
1104:        }
1105:        break;
1106:
1107:    case WM_CHAR:
1108:        if (self->m_editActive) {
