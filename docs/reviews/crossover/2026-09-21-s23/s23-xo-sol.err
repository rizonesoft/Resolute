670:    if (!m_provider) return;
671:    auto& c = Theme::Colors();
672:    float iconSz = Dpi::ScaleF(static_cast<float>(large ? BASE_ICON_LARGE : BASE_ICON_SMALL), m_dpi);
673:    float padX = Dpi::ScaleF(static_cast<float>(BASE_PADDING_X), m_dpi);
674:
675:    auto textFmt = Typography::Format(TypeStyle::Caption, FontWeight::Regular, m_dpi);
676:    if (textFmt) {
677:        textFmt->SetTextAlignment(large ? DWRITE_TEXT_ALIGNMENT_CENTER : DWRITE_TEXT_ALIGNMENT_LEADING);
678:        textFmt->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_NEAR);
679:        textFmt->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
680:    }
681:
682:    auto textCol = ToD2DColor(c.text);
683:    float cornerR = Dpi::ScaleF(4.0f, m_dpi);
684:
685:    for (int i = 0; i < m_itemCount; i++) {
686:        auto cellRc = GridCellRect(i);
687:        if (cellRc.bottom < 0 || cellRc.top > size.height) continue;
688:
689:        // Selection
690:        if (i == m_selected && m_selAlpha > 0.001f) {
691:            auto acCol = ToD2DColor(c.accent); acCol.a = 0.12f * m_selAlpha;
692:            br->SetColor(acCol);
693:            m_rt->FillRoundedRectangle(D2D1::RoundedRect(cellRc, cornerR, cornerR), br);
694:        }
695:
696:        // Hover
697:        if (i == m_hovered && m_hoverAlpha > 0.001f) {
698:            auto hvCol = ToD2DColor(c.surfaceHover); hvCol.a = m_hoverAlpha * 0.08f;
699:            br->SetColor(hvCol);
700:            m_rt->FillRoundedRectangle(D2D1::RoundedRect(cellRc, cornerR, cornerR), br);
701:        }
702:
703:        auto& item = m_provider(i);
704:        if (large) {
705:            float iconX = cellRc.left + ((cellRc.right - cellRc.left) - iconSz) * 0.5f;
706:            float iconY = cellRc.top + Dpi::ScaleF(8.0f, m_dpi);
707:            D2D1_RECT_F iconRc = D2D1::RectF(iconX, iconY, iconX + iconSz, iconY + iconSz);
708:            HICON hIco = item.icon ? item.icon : m_fallbackIcon;
709:            if (auto* bmp = GetIconBitmap(hIco))
710:                m_rt->DrawBitmap(bmp, iconRc, 1.0f, D2D1_BITMAP_INTERPOLATION_MODE_LINEAR);
711:
712:            if (!item.cells.empty() && textFmt) {
713:                D2D1_RECT_F labelRc = D2D1::RectF(cellRc.left + 4, iconY + iconSz + 4,
714:                    cellRc.right - 4, cellRc.bottom - 4);
715:                br->SetColor(textCol);
716:                m_rt->DrawText(item.cells[0].c_str(),
717:                    static_cast<UINT32>(item.cells[0].length()),
718:                    textFmt.Get(), labelRc, br);
719:            }
720:        } else {
721:            float iconY = cellRc.top + ((cellRc.bottom - cellRc.top) - iconSz) * 0.5f;
722:            D2D1_RECT_F iconRc = D2D1::RectF(cellRc.left + padX, iconY,
723:                cellRc.left + padX + iconSz, iconY + iconSz);
724:            HICON hIco = item.icon ? item.icon : m_fallbackIcon;
725:            if (auto* bmp = GetIconBitmap(hIco))
726:                m_rt->DrawBitmap(bmp, iconRc, 1.0f, D2D1_BITMAP_INTERPOLATION_MODE_LINEAR);
727:
728:            if (!item.cells.empty() && textFmt) {
729:                D2D1_RECT_F labelRc = D2D1::RectF(cellRc.left + padX + iconSz + 6,
730:                    cellRc.top, cellRc.right - padX, cellRc.bottom);
731:                textFmt->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_CENTER);
732:                br->SetColor(textCol);
733:                m_rt->DrawText(item.cells[0].c_str(),
734:                    static_cast<UINT32>(item.cells[0].length()),
735:                    textFmt.Get(), labelRc, br);
736:            }
737:        }
738:    }
739:}
