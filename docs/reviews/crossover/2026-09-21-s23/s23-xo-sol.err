976:        self->m_scrollbarHovered = false;
977:        self->ScheduleScrollbarHide();
978:        self->Repaint();
979:        return 0;
980:
981:    case WM_LBUTTONDOWN: {
982:        SetFocus(hwnd);
983:        int mx = GET_X_LPARAM(lp), my = GET_Y_LPARAM(lp);
984:
985:        // Scrollbar drag start
986:        if (self->HitTestScrollbar(mx, my)) {
987:            self->m_scrollbarDragging = true;
988:            self->m_scrollbarDragStart = static_cast<float>(my);
989:            self->m_scrollDragStartY = self->m_scrollY;
990:            SetCapture(hwnd);
991:            return 0;
992:        }
993:
994:        // Column resize start
995:        if (self->m_viewMode == ViewMode::Details && static_cast<float>(my) < self->HeaderHeight()) {
996:            int edge = self->HitTestColumnEdge(mx);
997:            if (edge >= 0) {
998:                self->m_resizingCol = edge;
999:                self->m_resizeStartX = static_cast<float>(mx);
1000:                self->m_resizeOrigW = self->m_columns[edge].width;
1001:                SetCapture(hwnd);
1002:                return 0;
1003:            }
1004:            // Column header click for sorting
1005:            int col = self->HitTestColumn(mx);
1006:            if (col >= 0 && self->m_columns[col].sortable) {
1007:                bool asc = (col == self->m_sortCol) ? !self->m_sortAscending : true;
1008:                self->SetSortColumn(col, asc);
1009:            }
1010:            return 0;
1011:        }
1012:
1013:        // Row selection
1014:        int hitRow = -1;
1015:        if (self->m_viewMode == ViewMode::Details || self->m_viewMode == ViewMode::List)
1016:            hitRow = self->HitTestRow(my);
1017:        else
1018:            hitRow = self->GridHitTest(mx, my);
1019:
1020:        if (hitRow >= 0) {
1021:            // End any active edit
1022:            if (self->m_editActive) self->EndEdit(true);
1023:
1024:            // Slow double-click detection for inline edit
1025:            if (hitRow == self->m_lastClickIdx && self->m_editClickTimer) {
1026:                KillTimer(hwnd, self->m_editClickTimer);
1027:                self->m_editClickTimer = 0;
1028:                self->BeginEdit(hitRow, 0);
1029:                return 0;
1030:            }
1031:
1032:            self->Select(hitRow);
1033:            self->m_lastClickIdx = hitRow;
1034:            SendMessageW(self->m_parent, WM_COMMAND,
1035:                MAKEWPARAM(self->m_id, IDC_LISTVIEW_SELECT),
1036:                reinterpret_cast<LPARAM>(hwnd));
1037:
1038:            // Start slow double-click timer (500ms)
1039:            self->m_editClickTimer = SetTimer(hwnd, 0xAA02, 500, nullptr);
1040:        } else {
1041:            if (self->m_editActive) self->EndEdit(true);
1042:        }
1043:        return 0;
1044:    }
1045:
1046:    case WM_LBUTTONUP:
1047:        if (self->m_resizingCol >= 0) {
1048:            self->m_resizingCol = -1;
1049:            ReleaseCapture();
1050:        }
1051:        if (self->m_scrollbarDragging) {
1052:            self->m_scrollbarDragging = false;
