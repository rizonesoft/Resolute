1110:            if (ch == VK_RETURN || ch == VK_ESCAPE || ch < 0x20) break;
1111:            self->m_editText.insert(self->m_editCursorPos, 1, ch);
1112:            self->m_editCursorPos++;
1113:            self->m_cursorBlinkPhase = 0.0f;
1114:            self->Repaint();
1115:            return 0;
1116:        }
1117:        break;
