1062:            hitRow = self->HitTestRow(my);
1063:        else
1064:            hitRow = self->GridHitTest(mx, my);
1065:        if (hitRow >= 0) {
1066:            if (self->m_editClickTimer) { KillTimer(hwnd, self->m_editClickTimer); self->m_editClickTimer = 0; }
1067:            self->m_lastClickIdx = -1;
1068:            SendMessageW(self->m_parent, WM_COMMAND,
1069:                MAKEWPARAM(self->m_id, IDC_LISTVIEW_DBLCLK),
1070:                reinterpret_cast<LPARAM>(hwnd));
1071:        }
1072:        return 0;
1073:    }
1074:
1075:    case WM_KEYDOWN:
1076:        switch (wp) {
1077:        case VK_UP:
1078:            if (self->m_selected > 0) {
