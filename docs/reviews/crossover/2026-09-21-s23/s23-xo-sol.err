770:
771:        if (i == m_selected && m_selAlpha > 0.001f) {
772:            auto ac = ToD2DColor(c.accent); ac.a = 0.12f * m_selAlpha;
773:            br->SetColor(ac);
774:            m_rt->FillRectangle(D2D1::RectF(0, rowTop, size.width, rowBot), br);
775:        }
776:
777:        if (i == m_hovered && m_hoverAlpha > 0.001f) {
778:            auto hc = ToD2DColor(c.surfaceHover); hc.a = m_hoverAlpha * 0.08f;
779:            br->SetColor(hc);
780:            m_rt->FillRectangle(D2D1::RectF(0, rowTop, size.width, rowBot), br);
781:        }
782:
783:        auto& item = m_provider(i);
784:        float textLeft = padX;
785:        HICON hIco = item.icon ? item.icon : m_fallbackIcon;
970:        return 0;
971:    }
972:
973:    case WM_MOUSELEAVE:
974:        self->AnimateHover(-1);
